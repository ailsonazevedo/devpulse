# ─── Database / Redis ────────────────────────────────────────────────
DATABASE_URL="postgresql://devpulse:devpulse@localhost:5433/devpulse?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── App auth (Auth.js) ──────────────────────────────────────────────
# gere com: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# ─── Secrets encryption (envelope / AES-256-GCM) ─────────────────────
# chave mestra de 32 bytes em base64: openssl rand -base64 32
MASTER_KEY="change-me-32-bytes-base64"

# ─── GitHub OAuth App ────────────────────────────────────────────────
# https://github.com/settings/developers  (callback: {AUTH_URL}/api/oauth/github/callback)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── GitLab OAuth App (gitlab.com) ───────────────────────────────────
# callback: {AUTH_URL}/api/oauth/gitlab/callback
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""

# ─── Azure DevOps ────────────────────────────────────────────────────
# Suporte atual é via Personal Access Token (PAT): na tela de Conexões,
# informe o PAT + a URL da organização (ex.: https://dev.azure.com/sua-org)
# ou a URL da collection no Azure DevOps Server (self-hosted).
# Escopos mínimos do PAT: Code (read), Work Items (read).
# OAuth (Entra ID) é opcional e fica desabilitado enquanto vazio:
# callback: {AUTH_URL}/api/oauth/azure/callback
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
